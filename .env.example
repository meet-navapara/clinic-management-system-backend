# Server
PORT=5000

# MongoDB — replace placeholders with your Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — use a long random string in your local .env (never commit .env)
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRES_IN=7d

# WhatsApp — country code + number, no + sign (e.g. 91XXXXXXXXXX)
WHATSAPP_CLINIC_NUMBER=<your-clinic-whatsapp-number>

# One-time clinic admin setup key (separate from doctor accounts)
ADMIN_SETUP_SECRET=<choose-a-strong-setup-secret>

# Frontend origins for CORS + password-reset links (comma-separated, no trailing slash).
# First entry is used in reset-password emails.
CLIENT_ORIGINS=https://zhealth.world,https://www.zhealth.world,http://localhost:3000

# --- Campaign / WhatsApp providers (real sends only) ---
# Appointment confirmations & reminders use the templates below.
# Campaign WhatsApp uses a per-clinic template: Doctor submits → Super Admin creates on MSG91
# → Super Admin approves under Admin → WA Templates. Campaigns never use appointment_confirmation.
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_TEMPLATE_NAME=appointment_confirmation
MSG91_WHATSAPP_REMINDER_TEMPLATE_NAME=appointment_reminder
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_LANGUAGE=en
MSG91_WHATSAPP_BODY_VARS=patientName,clinicName,doctorName,dateLabel,timeSlot
# SMS is not used for campaigns (WhatsApp + Email only).
# MSG91_SMS_SENDER_ID=
# MSG91_SMS_ROUTE=4
# MSG91_SMS_TEMPLATE_ID=

# Resend — REAL inbox email (signup OTP + password-reset links + campaigns)
# 1) Create account at https://resend.com
# 2) API Keys → Create API key → paste as RESEND_API_KEY
# 3) Domains → Add your domain (e.g. zhealth.world) → add DNS records → Verify
# 4) EMAIL_FROM must use that verified domain, e.g. Z Health <noreply@zhealth.world>
# Until the domain is verified, Resend only allows sending to your own signup email
# using: EMAIL_FROM="Z Health <onboarding@resend.dev>"
RESEND_API_KEY=
EMAIL_FROM="Z Health <noreply@zhealth.world>"
EMAIL_REPLY_TO=

# Optional SMTP fallback (Mailtrap sandbox or any SMTP). Used ONLY if Resend is not set.
# Mailtrap sandbox does NOT deliver to real inboxes — use Resend for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Legacy Mailtrap names still work as SMTP fallback:
MAILTRAP_HOST=
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
MAILTRAP_FROM=

# Webhook shared secret for /api/webhooks/comms/* (REQUIRED in production — webhooks fail closed without it)
COMMS_WEBHOOK_SECRET=<generate-a-long-random-secret>

# Auth cookie (optional overrides)
# Live frontend + API are usually different hosts → need SameSite=None + Secure
# so the session cookie is sent from every browser tab. Localhost can keep Lax.
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true

# Cloudinary — used for print logo & signature (and other clinic images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
