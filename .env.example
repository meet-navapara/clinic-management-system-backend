# Server
PORT=5000

# MongoDB — replace placeholders with your Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — use a long random string in your local .env (never commit .env)
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRES_IN=7d

# WhatsApp — country code + number, no + sign (e.g. 91XXXXXXXXXX)
WHATSAPP_CLINIC_NUMBER=<your-clinic-whatsapp-number>

# One-time clinic admin setup key (separate from doctor accounts)
ADMIN_SETUP_SECRET=<choose-a-strong-setup-secret>

# Frontend origins allowed by CORS (comma-separated). Defaults include local Vite ports 3000/5173.
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Campaign communication providers (real sends only; leave blank to block sending) ---
# MSG91 WhatsApp + SMS
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_TEMPLATE_NAME=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_LANGUAGE=en
MSG91_WHATSAPP_BODY_VARS=patientName,clinicName,doctorName
MSG91_SMS_SENDER_ID=
MSG91_SMS_ROUTE=4
MSG91_SMS_TEMPLATE_ID=

# Resend email
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Webhook shared secret for /api/webhooks/comms/* (REQUIRED in production — webhooks fail closed without it)
COMMS_WEBHOOK_SECRET=<generate-a-long-random-secret>

# Auth cookie (optional overrides)
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true

# Cloudinary — used for print logo & signature (and other clinic images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
